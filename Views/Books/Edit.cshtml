@model BookVerse.Models.Book

@{
    ViewData["Title"] = "Edit Book - " + Model.Title;
}

<div class="max-w-3xl mx-auto animate-fade-in" style="max-width: 800px;">
    <!-- Navigation Link -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center gap-1 text-slate-600 hover-text-primary">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Library</span>
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-slate-900 text-white py-4 px-4 px-md-5 border-0">
            <h2 class="h4 mb-1 text-white"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Book Details</h2>
            <p class="text-slate-400 mb-0 text-sm">Modify the details of the book below.</p>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert"></div>

                <!-- Hidden Primary Key and CreatedAt properties -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <!-- Form Grid Layout -->
                <div class="row g-4 mb-4">
                    <!-- Title -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Title" class="form-label fw-semibold text-slate-700"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., The Pragmatic Programmer" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Author -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Author" class="form-label fw-semibold text-slate-700"></label>
                        <input asp-for="Author" class="form-control" placeholder="e.g., Andrew Hunt" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold text-slate-700"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="">-- Select Category --</option>
                            <option value="Programming">Programming</option>
                            <option value="Science">Science</option>
                            <option value="Business">Business</option>
                            <option value="History">History</option>
                            <option value="Self Development">Self Development</option>
                            <option value="Fiction">Fiction</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold text-slate-700"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="1" max="1000" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <!-- Publish Date -->
                    <div class="col-12 col-md-4">
                        <label asp-for="PublishDate" class="form-label fw-semibold text-slate-700"></label>
                        <input asp-for="PublishDate" class="form-control" type="date" />
                        <span asp-validation-for="PublishDate" class="text-danger"></span>
                    </div>

                    <!-- Pages -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Pages" class="form-label fw-semibold text-slate-700"></label>
                        <input asp-for="Pages" class="form-control" type="number" min="10" max="3000" placeholder="e.g., 350" />
                        <span asp-validation-for="Pages" class="text-danger"></span>
                    </div>

                    <!-- Language -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Language" class="form-label fw-semibold text-slate-700"></label>
                        <input asp-for="Language" class="form-control" placeholder="e.g., English" />
                        <span asp-validation-for="Language" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-slate-700"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief summary of the book (max 500 characters)..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-3 border-top border-slate-100 pt-4">
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2.5">
                        <i class="bi bi-save"></i>
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Index" class="btn btn-secondary d-flex align-items-center gap-2 px-4 py-2.5">
                        <i class="bi bi-x-lg"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
