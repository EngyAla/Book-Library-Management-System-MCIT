@model IEnumerable<BookVerse.Models.Book>

@{
    ViewData["Title"] = "Personal Library";
    var currentFilter = ViewData["CurrentFilter"] as string;
}

@functions {
    public string GetCategoryBadgeClass(string category)
    {
        return category switch
        {
            "Programming" => "bg-programming",
            "Science" => "bg-science",
            "Business" => "bg-business",
            "History" => "bg-history",
            "Self Development" => "bg-self-development",
            "Fiction" => "bg-fiction",
            _ => "bg-default"
        };
    }
}

<div class="d-flex flex-column gap-4">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h2 mb-1">Book Library</h1>
            <p class="text-muted mb-0">Manage and organize the books in your personal library collection.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Add New Book</span>
            </a>
        </div>
    </div>

    <!-- Search / Filter Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="searchString" value="@currentFilter" class="form-control border-start-0 ps-0" placeholder="Search by title, author, or category..." aria-label="Search books" />
                    </div>
                </div>
                <div class="col-12 col-md-5 col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-funnel"></i>
                        <span>Search</span>
                    </button>
                    @if (!string.IsNullOrEmpty(currentFilter))
                    {
                        <a asp-action="Index" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Reset</span>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-journal-x text-muted mb-3" style="font-size: 3.5rem;"></i>
                <h3 class="h5">No Books Found</h3>
                <p class="text-muted max-w-md mx-auto">
                    We couldn't find any books matching your search criteria. Try adjusting your filters or add a new book to start your library.
                </p>
                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-secondary mt-2">Clear Search</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive border-0 shadow-sm">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Language</th>
                        <th>Pages</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-slate-900">@item.Title</div>
                            </td>
                            <td>
                                <span class="text-slate-700">@item.Author</span>
                            </td>
                            <td>
                                <span class="badge badge-category @GetCategoryBadgeClass(item.Category)">
                                    @item.Category
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-slate-800">@item.Price.ToString("C")</span>
                            </td>
                            <td>
                                <span class="text-slate-600 text-sm">@(string.IsNullOrEmpty(item.Language) ? "N/A" : item.Language)</span>
                            </td>
                            <td>
                                <span class="text-slate-600">@item.Pages pages</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary p-2 d-inline-flex align-items-center" title="Edit book">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary p-2 d-inline-flex align-items-center" title="View details">
                                        <i class="bi bi-eye fs-6"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger p-2 d-inline-flex align-items-center" title="Delete book">
                                        <i class="bi bi-trash fs-6"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
