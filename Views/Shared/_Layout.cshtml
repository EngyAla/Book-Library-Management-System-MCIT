@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookVerse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookVerse.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="page-wrapper">

        <!-- Sticky Header (Navbar spans full browser width) -->
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-dark bg-slate-900 shadow-sm py-3">
                <div class="container-fluid px-4 px-md-5">
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-extrabold text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-book-half text-primary fs-3"></i>
                        <span class="tracking-tight brand-logo">BookVerse</span>
                    </a>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-pill @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-pill @(currentController == "Books" ? "active" : "")" asp-area="" asp-controller="Books" asp-action="Index">
                                    <i class="bi bi-collection me-1"></i>Books
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Body Wrapper -->
        <main class="content">
            <div class="container px-4 px-md-5">
                <div class="animate-fade-in">
                    @RenderBody()
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer py-4 bg-slate-900 border-top border-slate-800 text-slate-400 mt-auto mb-0">
            <div class="container-fluid px-4 px-md-5 text-center">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 fw-bold text-white">
                        <i class="bi bi-book-half text-primary"></i>
                        <span>BookVerse</span>
                    </div>
                    <div class="text-sm">
                        &copy; 2026 BookVerse. All rights reserved.
                    </div>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-slate-400 hover-text-primary text-decoration-none"><i class="bi bi-github fs-5"></i></a>
                        <a href="#" class="text-slate-400 hover-text-primary text-decoration-none"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-slate-400 hover-text-primary text-decoration-none"><i class="bi bi-globe fs-5"></i></a>
                    </div>
                </div>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
